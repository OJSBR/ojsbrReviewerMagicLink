#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.displayName"
msgstr "Granskarlänk i 30 dagar"

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.description"
msgstr "Håller granskarens enklicksåtkomstlänk giltig i 30 dagar med obegränsade klick, även efter påminnelser, och leder till inloggningsformuläret i stället för en felsida när den inte längre kan användas."

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.login.expired"
msgstr "Din åtkomstlänk har gått ut. Logga in med ditt användarnamn och lösenord för att fortsätta."

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.login.otherUser"
msgstr "Du var inloggad med ett annat konto. Logga in med granskarens användarnamn och lösenord för att fortsätta."

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.confirm.title"
