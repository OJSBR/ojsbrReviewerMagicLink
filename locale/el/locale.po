#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.displayName"
msgstr "Σύνδεσμος αξιολογητή για 30 ημέρες"

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.description"
msgstr "Διατηρεί έγκυρο για 30 ημέρες τον σύνδεσμο πρόσβασης με ένα κλικ του αξιολογητή, με απεριόριστα κλικ, και μετά από υπενθυμίσεις, και οδηγεί στη φόρμα σύνδεσης αντί για σελίδα σφάλματος όταν δεν μπορεί πλέον να χρησιμοποιηθεί."

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.login.expired"
msgstr "Ο σύνδεσμος πρόσβασής σας έληξε. Συνδεθείτε με το όνομα χρήστη και τον κωδικό σας για να συνεχίσετε."

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.login.otherUser"
msgstr "Είχατε συνδεθεί με άλλον λογαριασμό. Συνδεθείτε με το όνομα χρήστη και τον κωδικό του αξιολογητή για να συνεχίσετε."

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.confirm.title"
msgstr "Άνοιγμα της αξιολόγησης"

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.confirm.text"
msgstr "Πατήστε το παρακάτω κουμπί για να ανοίξετε την αξιολόγηση στην οποία προσκληθήκατε."

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.confirm.button"
msgstr "Άνοιγμα της αξιολόγησης"

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.settings.intro"
msgstr "Ο σύνδεσμος ενός κλικ στα μηνύματα αιτήματος αξιολόγησης και υπενθύμισης παραμένει έγκυρος για τον αριθμό ημερών παρακάτω, όσες φορές κι αν ανοιχτεί, και μετά από υπενθύμιση. Όταν δεν μπορεί πλέον να χρησιμοποιηθεί, οδηγεί στη φόρμα σύνδεσης και πίσω στην αξιολόγηση, ποτέ σε σελίδα σφάλματος."

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.settings.accessKeysDisabled"
msgstr "Ο σύνδεσμος ενός κλικ είναι απενεργοποιημένος για αυτό το περιοδικό (Ρυθμίσεις > Ροή εργασιών > Αξιολόγηση). Το πρόσθετο δεν κάνει τίποτα μέχρι να ενεργοποιηθεί."

