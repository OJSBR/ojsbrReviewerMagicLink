#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.displayName"
msgstr "Fagfellelenke i 30 dager"

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.description"
msgstr "Holder fagfellens ettklikks tilgangslenke gyldig i 30 dager med ubegrensede klikk, også etter påminnelser, og fører til innloggingsskjemaet i stedet for en feilside når den ikke lenger kan brukes."

