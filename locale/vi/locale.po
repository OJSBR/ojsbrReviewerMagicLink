#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.displayName"
msgstr "Liên kết người phản biện 30 ngày"

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.description"
msgstr "Giữ liên kết truy cập một lần nhấp của người phản biện có hiệu lực 30 ngày với số lần nhấp không giới hạn, kể cả sau lời nhắc, và dẫn đến biểu mẫu đăng nhập thay vì trang lỗi khi không còn dùng được."

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.login.expired"
msgstr "Liên kết truy cập của bạn đã hết hạn. Hãy đăng nhập bằng tên người dùng và mật khẩu để tiếp tục."

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.login.otherUser"
msgstr "Bạn đang đăng nhập bằng tài khoản khác. Hãy đăng nhập bằng tên người dùng và mật khẩu của người phản biện để tiếp tục."

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.confirm.title"
msgstr "Mở bài phản biện"

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.confirm.text"
msgstr "Nhấp vào nút bên dưới để mở bài phản biện mà bạn được mời."

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.confirm.button"
msgstr "Mở bài phản biện"

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.settings.intro"
msgstr "Liên kết một lần nhấp trong email yêu cầu phản biện và nhắc nhở vẫn có hiệu lực trong số ngày bên dưới, dù được mở bao nhiêu lần, kể cả sau lời nhắc. Khi không còn dùng được, liên kết dẫn đến biểu mẫu đăng nhập rồi trở lại bài phản biện, không bao giờ đến trang lỗi."

#, fuzzy
msgid "plugins.generic.ojsbrReviewerMagicLink.settings.accessKeysDisabled"
msgstr "Liên kết một lần nhấp đang tắt cho tạp chí này (Cài đặt > Quy trình > Phản biện). Plugin không làm gì cho đến khi được bật."

