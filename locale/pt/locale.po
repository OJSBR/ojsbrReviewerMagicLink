msgid "plugins.generic.ojsbrReviewerMagicLink.displayName"
msgstr "Ligação de revisor por 30 dias"

msgid "plugins.generic.ojsbrReviewerMagicLink.description"
msgstr "Mantém a ligação de acesso com um clique do revisor válida durante 30 dias, com cliques ilimitados, também depois dos lembretes, e leva ao formulário de acesso em vez de uma página de erro quando já não puder ser usada."

msgid "plugins.generic.ojsbrReviewerMagicLink.login.expired"
msgstr "A sua ligação de acesso expirou. Entre com o seu utilizador e palavra-passe para continuar."

msgid "plugins.generic.ojsbrReviewerMagicLink.login.otherUser"
msgstr "Tinha uma sessão iniciada com outra conta. Entre com o utilizador e a palavra-passe do revisor para continuar."

msgid "plugins.generic.ojsbrReviewerMagicLink.confirm.title"
msgstr "Abrir a revisão"

msgid "plugins.generic.ojsbrReviewerMagicLink.confirm.text"
msgstr "Clique no botão abaixo para abrir a revisão para a qual foi convidado."

msgid "plugins.generic.ojsbrReviewerMagicLink.confirm.button"
msgstr "Abrir a revisão"

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.intro"
msgstr "A ligação de um clique dos e-mails de pedido de revisão e de lembrete continua válida pelo número de dias abaixo, quantas vezes for aberta, também depois de um lembrete. Quando já não puder ser usada, leva ao formulário de acesso e de volta à revisão, nunca a uma página de erro."

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.accessKeysDisabled"
msgstr "A ligação de um clique está desligada nesta revista (Configurações > Fluxo de trabalho > Revisão). O plugin não faz nada até ser ligada."

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.area.validity"
msgstr "Validade"

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.validityDays"
msgstr "Dias de validade de cada ligação"

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.validityDays.description"
msgstr "Contados a partir do envio do e-mail. Entre 1 e 365."

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.validityDays.invalid"
msgstr "Indique um número de dias entre 1 e 365."

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.area.access"
msgstr "Quem entra sem palavra-passe"

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.area.access.description"
msgstr "A ligação só inicia a sessão de quem não tem nesta revista outro papel além dos permitidos abaixo. Gestores, editores, assistentes e administradores do site vão sempre para o formulário de acesso."

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.autoLogin"
msgstr "Iniciar a sessão do revisor automaticamente com a ligação"

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.allowAuthor"
msgstr "Também quando o revisor é autor nesta revista"

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.allowReader"
msgstr "Também quando o revisor é leitor nesta revista"

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.confirmPage"
msgstr "Mostrar uma página com o botão \"Abrir a revisão\" antes de iniciar a sessão (proteção adicional contra robôs de e-mail)"

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.area.uses"
msgstr "Últimas entradas pela ligação"

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.ignoredHeadRequests"
msgstr "Pedidos de robôs de e-mail ignorados (HEAD/OPTIONS): {$requests}"

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.uses.date"
msgstr "Data"

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.uses.user"
msgstr "Utilizador"

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.uses.review"
msgstr "Revisão"

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.uses.ip"
msgstr "IP"

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.uses.userAgent"
msgstr "Navegador"

msgid "plugins.generic.ojsbrReviewerMagicLink.settings.uses.none"
msgstr "Ainda não há entradas pela ligação."
